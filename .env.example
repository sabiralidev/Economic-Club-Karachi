# Required for MongoDB-backed API routes. Use a dedicated application database user.
MONGODB_URI=

# Required for admin sessions; use a cryptographically random value of at least 32 characters.
ADMIN_SESSION_SECRET=

# Used for canonical metadata and production same-origin checks.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set these only while manually running `npm run admin:create`; never commit real values.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=

# Optional; integration tests only run against a database whose name ends with `_test`.
TEST_MONGODB_URI=
